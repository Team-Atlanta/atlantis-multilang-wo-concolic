#!/bin/bash
set -e

libCRS download-build-output uniafl/project/ /src/
rm -rf /src/repo
libCRS download-build-output uniafl/src /src/repo

REDIS_DOMAIN=$(libCRS get-service-domain redis 2>/dev/null)
export CODE_INDEXER_REDIS_URL=redis://${REDIS_DOMAIN}:6379

export CP_PROJ_PATH=/src
export CP_SRC_PATH=/src/repo
cd /home/crs/blob-gen/multilang-llm-agent && python3 -m mlla.codeindexer.main --cp /src/ --redis $CODE_INDEXER_REDIS_URL

echo "Code indexing complete."
