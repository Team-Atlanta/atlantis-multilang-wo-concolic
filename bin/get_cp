#!/bin/bash

set -e

libCRS download-build-output uniafl/build /out
libCRS download-build-output uniafl/src /src
libCRS download-build-output uniafl/project/ /src/
if [ "$1" != "no_cov" ]; then
    if [ "$FUZZING_LANGUAGE" = "c" ] || [ "$FUZZING_LANGUAGE" = "c++" ]; then
      libCRS download-build-output coverage/build /coverage-out
    fi
fi

if [ "$1" != "no_config" ]; then
    mkdir -p /src/.aixcc/
    libCRS download-build-output uniafl/config.yaml /src/.aixcc/config.yaml
fi

libCRS download-build-output lsp/compile_commands.json /src/repo/compile_commands.json
